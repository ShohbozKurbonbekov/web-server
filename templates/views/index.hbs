           <input type="text" class="input_field" id="inputField" placeholder="Type any address......" autocomplete="off" autofocus name="address">
          <button class="button" id="btn" type="submit" role="search">
            Search
          </button>
         </div>
         </form>
         <ul class="weather_lists" id="weather__lists">
